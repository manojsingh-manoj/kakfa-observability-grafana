
local.file_match "order_service_logs" {
  path_targets = [
    {
      __path__ = "/var/log/order-service/order-service.json",
    },
  ]
}

loki.process "order_service_logs" {

  stage.json {
    expressions = {
      timestamp     = "timestamp",
      level         = "level",
      logger        = "logger",
      thread        = "thread",
      message       = "message",
      service       = "service",
      environment   = "environment",
      correlationId = "correlationId",
      eventType     = "eventType",
      operation     = "operation",
      orderId       = "orderId",
      httpMethod    = "httpMethod",
      httpPath      = "httpPath",
      httpStatus    = "httpStatus",
      durationMs    = "durationMs",
    }
  }

  stage.replace {
    expression = "(?i)(password|passwd|access_token|refresh_token|authorization)"
    replace    = "[REDACTED]"
  }

  stage.static_labels {
    values = {
      collector = "alloy",
    }
  }

  forward_to = []
}

loki.source.file "order_service_logs" {
  targets = local.file_match.order_service_logs.targets

  forward_to = [
    loki.process.order_service_logs.receiver,
  ]
}
